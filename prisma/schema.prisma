generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BRIDE
}

enum AppointmentStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum AppointmentTitle {
  // Shared stages (used by both Custom and RTW)
  CONSULTATION
  ALTERATION
  GOWN_COMPLETE
  COLLECTION_READY
  // Custom dress flow only
  MEASUREMENTS
  CALICO
  GOWN_IN_FABRIC
  DETAIL_ON
  // RTW flow only
  GOWN_TRY_ON
  // Generic
  CUSTOM
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum NotificationType {
  APPOINTMENT
  PAYMENT
  PHOTO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(BRIDE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  brideProfile  BrideProfile?
  appointments  Appointment[]
  fittings      Fitting[]
  inspoUploads  InspoUpload[]
  favorites     Favorite[]
  payments      Payment[]
  notifications Notification[]
  documents     Document[]

  @@map("users")
}

enum BrideStage {
  // Shared stages (used by both Custom and RTW)
  CONSULTATION
  ALTERATION
  GOWN_COMPLETE
  COLLECTION_READY
  // Custom dress stages only
  MEASUREMENTS
  CALICO
  GOWN_IN_FABRIC
  DETAIL_ON
  // RTW stages only
  GOWN_TRY_ON
}

enum BrideType {
  CUSTOM
  READY_TO_WEAR
}

model BrideProfile {
  id               String     @id @default(uuid())
  userId           String     @unique @map("user_id")
  brideType        BrideType  @default(CUSTOM) @map("bride_type")
  weddingDate      DateTime?  @map("wedding_date")
  phone            String?
  address          String?
  partnerName      String?    @map("partner_name")
  venueName        String?    @map("venue_name")
  guestCount       String?    @map("guest_count")
  dietaryNotes     String?    @map("dietary_notes")
  stylePreferences String?    @map("style_preferences")
  notes            String?
  totalGownAmount  Decimal?   @db.Decimal(10, 2) @map("total_gown_amount")
  stage            BrideStage @default(CONSULTATION)
  country          String     @default("Australia")
  currency         String     @default("AUD")
  createdAt        DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bride_profiles")
}

model Appointment {
  id              String            @id @default(uuid())
  brideId         String            @map("bride_id")
  title           AppointmentTitle
  description     String?
  location        String?
  startTime       DateTime          @map("start_time")
  endTime         DateTime          @map("end_time")
  whatToBring     String?           @map("what_to_bring")
  status          AppointmentStatus @default(SCHEDULED)
  createdBy       String            @map("created_by")
  googleEventId   String?           @map("google_event_id")
  icsUid          String?           @map("ics_uid")
  icsSequence     Int               @default(0) @map("ics_sequence")
  reminderSentAt  DateTime?         @map("reminder_sent_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  bride    User      @relation(fields: [brideId], references: [id], onDelete: Cascade)
  fittings Fitting[]

  @@map("appointments")
}

model Fitting {
  id            String   @id @default(uuid())
  brideId       String   @map("bride_id")
  appointmentId String?  @map("appointment_id")
  fittingNumber Int      @map("fitting_number")
  name          String
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  bride       User         @relation(fields: [brideId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  photos      FittingPhoto[]

  @@map("fittings")
}

model FittingPhoto {
  id         String   @id @default(uuid())
  fittingId  String   @map("fitting_id")
  imageUrl   String   @map("image_url")
  caption    String?
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  fitting Fitting @relation(fields: [fittingId], references: [id], onDelete: Cascade)

  @@map("fitting_photos")
}

model InspoUpload {
  id         String   @id @default(uuid())
  brideId    String   @map("bride_id")
  imageUrl   String?  @map("image_url")
  videoLink  String?  @map("video_link")
  mediaType  String   @default("image") @map("media_type")
  platform   String?
  caption    String?
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  bride User @relation(fields: [brideId], references: [id], onDelete: Cascade)

  @@map("inspo_uploads")
}

model Favorite {
  id        String   @id @default(uuid())
  brideId   String   @map("bride_id")
  title     String
  imageUrl  String   @map("image_url")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  bride User @relation(fields: [brideId], references: [id], onDelete: Cascade)

  @@map("favorites")
}

model Payment {
  id                   String           @id @default(uuid())
  brideId              String           @map("bride_id")
  amount               Decimal          @db.Decimal(10, 2)
  currency             String           @default("AUD")
  paymentType          AppointmentTitle @map("payment_type")
  status               PaymentStatus    @default(PENDING)
  dueDate              DateTime?        @map("due_date")
  paidDate             DateTime?        @map("paid_date")
  reminderSentAt       DateTime?        @map("reminder_sent_at")
  notes                String?
  exchangeRateToAUD    Decimal?         @db.Decimal(10, 6) @map("exchange_rate_to_aud")
  amountInAUD          Decimal?         @db.Decimal(10, 2) @map("amount_in_aud")
  exchangeRateSource   String?          @map("exchange_rate_source")
  convertedAt          DateTime?        @map("converted_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  bride User @relation(fields: [brideId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Notification {
  id        String           @id @default(uuid())
  brideId   String           @map("bride_id")
  type      NotificationType
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  sentAt    DateTime         @default(now()) @map("sent_at")

  bride User @relation(fields: [brideId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Document {
  id         String   @id @default(uuid())
  brideId    String   @map("bride_id")
  title      String
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  uploadedBy String   @map("uploaded_by")

  bride User @relation(fields: [brideId], references: [id], onDelete: Cascade)

  @@map("documents")
}
